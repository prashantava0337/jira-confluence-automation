{
  "servers": {
    "echo-Mac": {
      "type": "stdio",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/mcp-echo.py"]
    },
    "gettime-mac": {
      "type": "stdio",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/mcp-get-time.py"]
    },
    "Calculate-mac": {
      "type": "stdio",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/mcp-calculate.py"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}
