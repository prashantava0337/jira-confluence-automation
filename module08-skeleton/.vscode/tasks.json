{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Chrome (remote)",
      "type": "shell",
      "command": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
      "args": [
        "--remote-debugging-port=9222",
        "--user-data-dir=${workspaceFolder}/.vscode/chrome-profile",
        "http://localhost:5173"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Start Dev Server (client)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
